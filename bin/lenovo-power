#!/usr/bin/env bash
# lenovo-power - control Lenovo Legion power settings on Linux
# Targets the upstream lenovo_wmi_* / ideapad_laptop sysfs interfaces.

set -uo pipefail

# Every hardware path hangs off this root. It is empty in normal use, so the
# paths below are the real sysfs ones; the tests point it at a directory of
# fake hardware files to exercise the tool without a Legion under it.
SYS="${LENOVO_POWER_SYSFS_ROOT:-}/sys"

PROFILE=$SYS/firmware/acpi/platform_profile
PROFILE_CHOICES=$SYS/firmware/acpi/platform_profile_choices
vpc_devices=("$SYS"/bus/platform/devices/VPC2004:*[0-9]); VPC=${vpc_devices[0]}
FWA=$SYS/class/firmware-attributes/lenovo-wmi-other-0/attributes
PSTATE=$SYS/devices/system/cpu/intel_pstate
CPUDIR=$SYS/devices/system/cpu
HWMON=$SYS/class/hwmon
PCIDIR=$SYS/bus/pci/devices
BAT=$SYS/class/power_supply/BAT0
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/lenovo-power"
STATE_FILE=$STATE_DIR/state
LOG_FILE=$STATE_DIR/log.jsonl

# Who is making the change, as recorded in the log: user, preset or guard, and
# the context to attach to whatever is logged next. The guard sets the detail so
# that the temperature which triggered it lands on every entry it causes, even
# the ones written by commands that know nothing about the guard.
ACTOR=user
LOG_DETAIL=

# A rolling ceiling on the log. Trimming back well under the ceiling amortises
# the rewrite across the appends in between, rather than rewriting on every
# append once the file is full. Policy, not a tunable: no environment override.
LOG_MAX=5000
LOG_KEEP=4000

# Set by --yes, and by the gate once it has been satisfied for this run, so a
# preset that asks once up front does not ask again for each setting it writes.
ASSUME_YES=0
GATE_SATISFIED=0
GATE_NOTE=

# Thresholds. Compiled-in defaults, overridable by environment so the systemd
# unit can tune them without this needing a config file parser. They sit above
# ordinary load and below the firmware's first fan stage at 103 C, so the alert
# always precedes the guard and both precede the firmware's thermal ladder.
ALERT_TEMP=${LENOVO_POWER_ALERT_TEMP:-95}
ALERT_SUSTAIN=${LENOVO_POWER_ALERT_SUSTAIN:-30}
ALERT_REPEAT=${LENOVO_POWER_ALERT_REPEAT:-600}
GUARD_TEMP=${LENOVO_POWER_GUARD_TEMP:-100}
GUARD_SUSTAIN=${LENOVO_POWER_GUARD_SUSTAIN:-60}
GPU_MARGIN=${LENOVO_POWER_GPU_MARGIN:-5}
POLL_INTERVAL=${LENOVO_POWER_POLL_INTERVAL:-10}

# The raising profiles: the profiles whose selection is itself a raise. With
# cpu-limit and gpu-limit these are exactly the commands that both ask for
# confirmation and arm the thermal guard - one list serving both purposes, so a
# future power-raising command wires up both and neither can be forgotten.
RAISING_PROFILES="max-power custom"
raises_power() { [[ " $RAISING_PROFILES " == *" ${1} "* ]]; }

# ppd profile name <-> firmware platform_profile name
ppd_to_fw() { case "$1" in power-saver) echo low-power;; *) echo "$1";; esac; }
fw_to_ppd() { case "$1" in low-power) echo power-saver;; *) echo "$1";; esac; }

die() { echo "lenovo-power: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

# A typo in a unit's Environment= line would otherwise be read as zero, and a
# threshold of zero means "always triggered". Refuse to start instead.
for _t in ALERT_TEMP ALERT_SUSTAIN ALERT_REPEAT GUARD_TEMP GUARD_SUSTAIN GPU_MARGIN POLL_INTERVAL; do
  [[ ${!_t} =~ ^[0-9]+$ ]] || die "LENOVO_POWER_${_t} must be a whole number, got '${!_t}'"
done
unset _t

# Write to a root-owned sysfs file, escalating only when we must.
wr() {
  local path=$1 val=$2
  [[ -e $path ]] || { echo "  (unsupported on this machine: $path)" >&2; return 1; }
  if [[ -w $path ]]; then
    # Writable but still refused means the driver rejected the value, not a
    # permission problem - report what the kernel actually said.
    local err
    err=$({ printf '%s' "$val" >"$path"; } 2>&1) && return 0
    echo "  $(basename "$path"): kernel rejected '$val'${err:+ (${err##*: })}" >&2
    return 1
  fi
  # A non-empty root means these are fake files someone pointed us at, so never
  # escalate: sudo must not follow a path the environment chose.
  if [[ -z ${LENOVO_POWER_SYSFS_ROOT:-} ]] && have sudo; then
    # Try a cached/passwordless sudo first so scripts and keybinds never hang.
    printf '%s' "$val" | sudo -n tee "$path" >/dev/null 2>&1 && return 0
    if [[ -t 0 || -t 1 || -t 2 ]]; then
      printf '%s' "$val" | sudo tee "$path" >/dev/null && return 0
    fi
  fi
  echo "  cannot write $path (run: lenovo-power install-perms)" >&2
  return 1
}

rd() { [[ -r $1 ]] && cat "$1" 2>/dev/null; }

# ------------------------------------------------------- state and transaction log
#
# Two files, deliberately apart. The state file is small and rewritten in place;
# it holds what the guard needs to know - what was raised, from what, and
# whether it has already acted. The log only ever grows, and is never rewritten
# except to trim.

# One key per TAB-separated line. Values come from a controlled vocabulary
# (profile names, integers, epoch seconds), so no quoting is needed.
state_get() {
  local k v
  [[ -r $STATE_FILE ]] || return 0
  while IFS=$'\t' read -r k v; do
    [[ $k == "$1" ]] && { printf '%s\n' "$v"; return 0; }
  done <"$STATE_FILE"
  return 0
}

# Setting a key to the empty string removes it, which is how a key is cleared.
# A write that would change nothing is skipped, so the monitor's loop does not
# rewrite the file on every poll of an idle machine.
state_set() {
  local tmp
  [[ $(state_get "$1") == "${2:-}" ]] && return 0
  mkdir -p "$STATE_DIR" || return 1
  tmp=$STATE_FILE.$$
  {
    if [[ -r $STATE_FILE ]]; then awk -F'\t' -v k="$1" '$1 != k' "$STATE_FILE"; fi
    if [[ -n ${2:-} ]]; then printf '%s\t%s\n' "$1" "$2"; fi
  } >"$tmp" && mv -f "$tmp" "$STATE_FILE"
}

state_clear() { state_set "$1" ""; }

# Append one event: <actor> <setting> <from> <to> <outcome> [detail].
#
# JSONL rather than columns because the raw file's only readers are machines -
# 'history' renders it for humans - and because name-keyed assertions survive a
# new field where positional ones would not. Generating JSON from shell is
# normally an escaping hazard; here every value is a profile name, an integer,
# an ISO timestamp or a fixed outcome word, none of which can contain a quote,
# a tab or a newline. Revisit this if a free-text field is ever added.
#
# The CLI and the monitor are separate processes appending to the same file. One
# compact line per event stays well under the atomic-append size, so their
# writes can never interleave.
log_event() {
  local line detail=${6:-$LOG_DETAIL}
  mkdir -p "$STATE_DIR" || return 0
  printf -v line '{"ts":"%s","actor":"%s","setting":"%s","from":"%s","to":"%s","outcome":"%s"' \
    "$(date -Is)" "$1" "$2" "${3:--}" "${4:--}" "$5"
  [[ -n $detail ]] && printf -v line '%s,"detail":"%s"' "$line" "$detail"
  printf '%s}\n' "$line" >>"$LOG_FILE"
  log_trim
}

log_trim() {
  local n tmp
  n=$(wc -l <"$LOG_FILE" 2>/dev/null) || return 0
  (( n >= LOG_MAX )) || return 0
  tmp=$LOG_FILE.$$
  tail -n "$LOG_KEEP" "$LOG_FILE" >"$tmp" && mv -f "$tmp" "$LOG_FILE"
}

# Log a write and pass its success or failure through, so callers can write
#   wr_logged <setting> <path> <from> <to> [raw] || return 1
# and get both the write and its record in one step. RAW is the value actually
# written when it differs from the one worth logging, as for the 0/1 toggles
# that read back as on/off.
wr_logged() {
  local setting=$1 path=$2 from=$3 to=$4 raw=${5:-$4}
  if wr "$path" "$raw"; then
    log_event "$ACTOR" "$setting" "$from" "$to" applied
    return 0
  fi
  log_event "$ACTOR" "$setting" "$from" "$to" failed
  return 1
}

# Runtime PM state of the first NVIDIA PCI function, without waking it.
gpu_runtime_status() {
  local d
  for d in "$PCIDIR"/*; do
    [[ $(rd "$d/vendor") == 0x10de ]] || continue
    [[ $(rd "$d/class") == 0x030000 ]] || continue
    rd "$d/power/runtime_status"; return
  done
}

# The first hwmon directory reporting the given driver name, e.g. coretemp.
hwmon_by_name() {
  local h
  for h in "$HWMON"/hwmon*; do
    [[ $(rd "$h/name") == "$1" ]] || continue
    echo "$h"; return 0
  done
  return 1
}

# CPU package temperature in whole degrees C, from coretemp's "Package" sensor.
# Silent when coretemp or that sensor is absent; the caller shows a placeholder.
cpu_temp() {
  local h l v
  h=$(hwmon_by_name coretemp) || return
  for l in "$h"/temp*_label; do
    [[ $(rd "$l") == *Package* ]] || continue
    v=$(rd "${l%_label}_input") && [[ -n $v ]] && echo $(( (v + 500) / 1000 ))
    return
  done
}

# The dGPU's enforced power cap in watts, and the default the card ships with.
# Both go through nvidia-smi, so callers must check the card is awake first.
gpu_power_limit()   { nvidia-smi --query-gpu=enforced.power.limit --format=csv,noheader,nounits 2>/dev/null; }
gpu_default_limit() { nvidia-smi --query-gpu=power.default_limit --format=csv,noheader,nounits 2>/dev/null; }

# Join arguments into a readable list, with a word for the empty case.
join_list() {
  local out
  (( $# )) || return 0
  printf -v out '%s, ' "$@"
  echo "${out%, }"
}

turbo_state() { [[ $(rd $PSTATE/no_turbo) == 0 ]] && echo on || echo off; }

onoff()   { [[ ${1:-} == 1 ]] && echo on || echo off; }
to_bool() {
  case "${1,,}" in
    on|1|true|yes|enable|enabled) echo 1;;
    off|0|false|no|disable|disabled) echo 0;;
    *) die "expected on|off, got '${1}'";;
  esac
}

# ------------------------------------------------------------- the armed set
#
# What the guard is holding: one entry per raise that has not been given back,
# each keeping the setting's value from before the raise. The gate writes an
# entry, the guard reads them, gives back what it can, and latches.
#
# One table, so a new raisable setting is a row and three small handlers rather
# than an edit in five places. Each setting names:
#
#   budget_read_<key>              its current raw value
#   budget_plan_<key> <prior>      how to say what would be given back
#   budget_reverse_<key> <prior>   give it back, and say what was given back
#
# A reverse handler returns 0 when it gave the setting back, and only that
# disarms the entry. Any other status leaves it armed for a later trigger
# (docs/adr/0001); handlers use 1 for a reversal that was tried and failed and
# 2 for one that cannot be tried yet, which changes what they log but not what
# budget_give_back does with them.
BUDGET_SETTINGS="profile cpu_pl1 cpu_pl2 gpu"

# Not back to the prior value: a raise is given back by dropping to
# performance, which is why the plan does not name where it came from.
budget_read_profile()    { rd $PROFILE; }
budget_plan_profile()    { echo "drop the profile to performance"; }
budget_reverse_profile() {
  cmd_profile performance >/dev/null || return 1
  echo "profile to performance"
}

budget_read_cpu_pl1()    { rd $FWA/ppt_pl1_spl/current_value; }
budget_plan_cpu_pl1()    { echo "return PL1 to ${1} W"; }
budget_reverse_cpu_pl1() {
  wr_logged cpu-limit-pl1 $FWA/ppt_pl1_spl/current_value \
    "$(rd $FWA/ppt_pl1_spl/current_value)" "$1" || return 1
  echo "PL1 to ${1} W"
}

budget_read_cpu_pl2()    { rd $FWA/ppt_pl2_sppt/current_value; }
budget_plan_cpu_pl2()    { echo "return PL2 to ${1} W"; }
budget_reverse_cpu_pl2() {
  wr_logged cpu-limit-pl2 $FWA/ppt_pl2_sppt/current_value \
    "$(rd $FWA/ppt_pl2_sppt/current_value)" "$1" || return 1
  echo "PL2 to ${1} W"
}

budget_read_gpu() { gpu_power_limit; }
budget_plan_gpu() { echo "return the dGPU cap to the card's default (raised from ${1} W)"; }
# Only while the card is already awake. Monitoring must never be the thing that
# resumes a suspended dGPU, and a sleeping card draws nothing and adds no heat,
# so a raised cap waits for a poll that finds the card up.
budget_reverse_gpu() {
  local prior=$1 default
  [[ $(gpu_runtime_status) == active ]] || return 2
  default=$(gpu_default_limit)
  # -n because this runs from a background service, where there is nobody to
  # answer a password prompt; a refusal is recorded rather than waited on.
  if [[ -n $default ]] && sudo -n nvidia-smi -pl "$default" >/dev/null 2>&1; then
    log_event "$ACTOR" gpu-limit "$prior" "$default" applied
    echo "dGPU cap to ${default} W"
    return 0
  fi
  log_event "$ACTOR" gpu-limit "$prior" "${default:--}" failed \
    "nvidia-smi needs root, which a user service does not have"
  return 1
}

# What this process armed, so a raise that fails knows whether any part of it
# landed. The latch is stashed once per run: a preset gates twice, and the
# second gate must not stash a latch the first one has already cleared.
BUDGET_ARMED_THIS_RUN=
BUDGET_LATCH_STASHED=0
BUDGET_PRIOR_LATCH=
BUDGET_PRIOR_GAVE=

budget_stash_latch() {
  (( BUDGET_LATCH_STASHED )) && return 0
  BUDGET_PRIOR_LATCH=$(state_get latched)
  BUDGET_PRIOR_GAVE=$(state_get latched_gave)
  BUDGET_LATCH_STASHED=1
  state_clear latched
  state_clear latched_gave
}

budget_arm() {
  state_set "armed_$1" "$(budget_read_"$1")"
  BUDGET_ARMED_THIS_RUN+=" $1"
}

# A raise that did not land must not leave the guard believing it did. Give up
# the entries named, and put the latch back only when nothing this run armed
# survives - a cpu-limit whose PL2 failed after PL1 landed has still raised a
# budget, so its latch stays off.
budget_abandon() {
  local key
  for key in "$@"; do state_clear "armed_$key"; done
  for key in $BUDGET_ARMED_THIS_RUN; do
    [[ -n $(state_get "armed_$key") ]] && return 0
  done
  state_set latched "$BUDGET_PRIOR_LATCH"
  state_set latched_gave "$BUDGET_PRIOR_GAVE"
}

# What the guard would give back if it triggered right now.
budget_plan() {
  local key prior out=()
  for key in $BUDGET_SETTINGS; do
    prior=$(state_get "armed_$key")
    [[ -n $prior ]] && out+=("$(budget_plan_"$key" "$prior")")
  done
  (( ${#out[@]} )) || { echo "nothing - no raised power budget to give back"; return 0; }
  join_list "${out[@]}"
}

# Give back everything that can go back now, and latch. Echoes what this call
# gave back; empty output and a non-zero status mean nothing went back.
budget_give_back() {
  local key prior phrase gave=() episode so_far
  for key in $BUDGET_SETTINGS; do
    prior=$(state_get "armed_$key")
    [[ -n $prior ]] || continue
    if phrase=$(budget_reverse_"$key" "$prior"); then
      gave+=("$phrase")
      state_clear "armed_$key"
    fi
  done
  (( ${#gave[@]} )) || return 1
  episode=$(join_list "${gave[@]}")

  # The latch is one episode, not one give-back: it goes on when the guard
  # first takes something back, and comes off only when the user raises again.
  # So the moment stays put, and a later give-back adds to the summary.
  so_far=$(state_get latched_gave)
  state_set latched_gave "${so_far:+$so_far, }$episode"
  [[ -n $(state_get latched) ]] || state_set latched "$(epoch)"
  printf '%s\n' "$episode"
}

budget_latched() { [[ -n $(state_get latched) ]]; }

budget_latch_at() {
  local t; t=$(state_get latched)
  [[ -n $t ]] && date -d "@$t" '+%Y-%m-%d %H:%M' 2>/dev/null
  return 0
}

budget_latch_gave() { state_get latched_gave; }

# ------------------------------------------------------------------- the gate
#
# Confirmation is the moment the tool explains itself, so the prompt names the
# setting, what it is now and what it would become, and says what the change is
# and is not.
#
# gate <setting> <row>... where each row is "label|current|new" and may carry
# a fourth field naming the armed-set key that the row raises.
gate() {
  local setting=$1; shift

  # A refusal is worth as much in the log as a success, so it records what was
  # being asked for and not merely that something was declined. The first row is
  # the headline change; the rest, if any, come with it.
  # A trailing field names the armed-set key, so it is read and dropped here:
  # without it read would hand the last variable the remainder of the row.
  local gfrom=- gto=-
  (( $# )) && IFS='|' read -r _ gfrom gto _ <<<"$1"

  # A CPU already in the guard's territory refuses the raise outright, and
  # --yes deliberately does not override this one: a scripting convenience must
  # not punch through a thermal guard, or a raise could walk straight back into
  # the state the guard just pulled the machine out of.
  local temp; temp=$(cpu_temp)
  if [[ -n $temp ]] && (( temp >= GUARD_TEMP )); then
    log_event "$ACTOR" "$setting" "$gfrom" "$gto" refused \
      "CPU at ${temp} C, at or above the ${GUARD_TEMP} C guard trigger"
    echo "lenovo-power: refusing to raise $setting - the CPU is at ${temp} °C, at or above" >&2
    echo "  the ${GUARD_TEMP} °C thermal guard trigger. Let it cool first." >&2
    echo "  (--yes does not override this.)" >&2
    return 1
  fi

  if (( ! GATE_SATISFIED && ! ASSUME_YES )); then
    # Fail closed. Launched from a keybinding or a service there is nowhere to
    # prompt, and a gate that opens itself when nobody is watching is not a gate.
    if [[ ! -t 0 ]]; then
      log_event "$ACTOR" "$setting" "$gfrom" "$gto" refused "no terminal to confirm on"
      echo "lenovo-power: refusing to raise $setting with no terminal to confirm on." >&2
      echo "  Run it from a terminal, or pass --yes if you meant this from a script." >&2
      return 1
    fi

    local row label cur new reply
    {
      echo
      echo "lenovo-power: this raises a power budget."
      echo
      for row in "$@"; do
        IFS='|' read -r label cur new _ <<<"$row"
        printf '  %-18s %s  ->  %s\n' "$label" "$cur" "$new"
      done
      echo
      [[ -n $GATE_NOTE ]] && { echo "  $GATE_NOTE"; echo; }
      echo "  This changes how many watts the hardware may draw, at stock clocks. It is"
      echo "  not overclocking: no clock multiplier and no voltage is touched, and the"
      echo "  firmware's thermal ladder still applies and cannot be disabled."
      echo
      echo "  The thermal guard gives this back if the CPU stays at or above ${GUARD_TEMP} °C"
      echo "  for ${GUARD_SUSTAIN}s."
      echo
    } >&2
    read -r -p "  Apply? [y/N] " reply
    echo >&2
    case "${reply,,}" in
      y|yes) ;;
      *)
        log_event "$ACTOR" "$setting" "$gfrom" "$gto" refused "declined at the prompt"
        echo "lenovo-power: cancelled." >&2
        return 1 ;;
    esac
  fi

  # Getting here is the deliberate re-enable the guard waits for, so the latch
  # comes off: the user has just been shown the state and chosen it. The old
  # value is kept, because a raise that then fails to write has not re-enabled
  # anything and must not leave the latch off.
  GATE_SATISFIED=1
  budget_stash_latch

  # Confirming is arming, so a raise cannot be approved without the guard being
  # told what it may give back. Armed before the write, because the guard
  # cannot give back what nobody wrote down, and given up again by
  # budget_abandon when the write does not land.
  local arm_row arm_parts
  for arm_row in "$@"; do
    IFS='|' read -r -a arm_parts <<<"$arm_row"
    (( ${#arm_parts[@]} >= 4 )) && [[ -n ${arm_parts[3]} ]] && budget_arm "${arm_parts[3]}"
  done
  return 0
}

# ---------------------------------------------------------------- status

cmd_status() {
  local prof choices cons usbc fnl pl1 pl2 epp turbo temp
  prof=$(rd $PROFILE); choices=$(rd $PROFILE_CHOICES)
  cons=$(rd $VPC/conservation_mode); usbc=$(rd $VPC/usb_charging); fnl=$(rd $VPC/fn_lock)
  pl1=$(rd $FWA/ppt_pl1_spl/current_value); pl2=$(rd $FWA/ppt_pl2_sppt/current_value)
  epp=$(rd $CPUDIR/cpu0/cpufreq/energy_performance_preference)
  turbo=$(rd $PSTATE/no_turbo)
  temp=$(cpu_temp); temp=${temp:+$temp °C}

  echo "Power profile"
  printf '  platform profile   %s\n' "${prof:-n/a}"
  printf '  available          %s\n' "${choices:-n/a}"
  if have powerprofilesctl; then
    printf '  power-profiles-d   %s\n' "$(powerprofilesctl get 2>/dev/null || echo n/a)"
  fi
  # Say so when the guard is holding the machine down, so a profile that will
  # not stick is never a mystery.
  if budget_latched; then
    printf '  thermal guard      latched %s: gave back %s\n' \
      "$(budget_latch_at)" "$(budget_latch_gave)"
    printf '                     and stays here until you raise a budget again\n'
  fi

  echo
  echo "CPU"
  printf '  temperature        %s\n' "${temp:-n/a}"
  printf '  EPP                %s\n' "${epp:-n/a}"
  printf '  turbo              %s\n' "$(turbo_state)"
  printf '  PL1 sustained      %s W  (range %s-%s, default %s)\n' \
    "${pl1:-n/a}" "$(rd $FWA/ppt_pl1_spl/min_value)" "$(rd $FWA/ppt_pl1_spl/max_value)" "$(rd $FWA/ppt_pl1_spl/default_value)"
  printf '  PL2 burst          %s W  (range %s-%s, default %s)\n' \
    "${pl2:-n/a}" "$(rd $FWA/ppt_pl2_sppt/min_value)" "$(rd $FWA/ppt_pl2_sppt/max_value)" "$(rd $FWA/ppt_pl2_sppt/default_value)"

  if have nvidia-smi; then
    echo
    echo "dGPU"
    local pmctl; pmctl=$(gpu_runtime_status)
    if [[ $pmctl == suspended ]]; then
      # Querying nvidia-smi resumes the card and burns ~10 W. Not worth it just
      # to draw a status line, so report the good news and leave it asleep.
      printf '  runtime pm         suspended (not queried - waking it costs power)\n'
    else
      nvidia-smi --query-gpu=name,power.draw,enforced.power.limit,power.min_limit,power.max_limit \
        --format=csv,noheader,nounits 2>/dev/null | \
        awk -F', ' '{printf "  %s\n  draw               %s W\n  limit              %s W  (range %s-%s)\n",$1,$2,$3,$4,$5}'
      printf '  runtime pm         %s\n' "${pmctl:-n/a}"
    fi
  fi

  echo
  echo "Battery"
  local cap st rate
  cap=$(rd $BAT/capacity); st=$(rd $BAT/status)
  rate=$(rd $BAT/power_now)
  printf '  charge             %s%% (%s)\n' "${cap:-?}" "${st:-?}"
  [[ -n $rate ]] && printf '  draw               %.1f W\n' "$(awk -v u="$rate" 'BEGIN{print u/1000000}')"
  printf '  conservation mode  %s  (caps charge ~60%% to preserve the cell)\n' "$(onoff "${cons:-}")"

  echo
  echo "Misc"
  printf '  USB always-on      %s\n' "$(onoff "${usbc:-}")"
  printf '  Fn lock            %s\n' "$(onoff "${fnl:-}")"
  local f1 f2 h
  if h=$(hwmon_by_name lenovo_wmi_other); then
    f1=$(rd "$h/fan1_input"); f2=$(rd "$h/fan2_input")
  fi
  [[ -n ${f1:-} ]] && printf '  fans               %s / %s rpm (read-only)\n' "$f1" "$f2"

  # Nudge toward the one-time setup if the knobs still need root.
  if [[ ! -w $PROFILE ]]; then
    echo
    echo "  Most settings still need sudo. Run 'lenovo-power install-perms' once"
    echo "  to let your user change them directly."
  fi
}

# ---------------------------------------------------------------- profile

cmd_profile() {
  local want=${1:-}
  if [[ -z $want ]]; then rd $PROFILE; return; fi
  local choices; choices=$(rd $PROFILE_CHOICES)
  want=$(ppd_to_fw "$want")
  [[ " $choices " == *" $want "* ]] || die "profile must be one of: $choices"

  # One logical change reached by three routes - the daemon, a raw sysfs write,
  # or the reconcile below - so this logs once at the end rather than through
  # wr_logged, which pairs a single write with a single record.
  #
  # Let power-profiles-daemon own the profiles it knows about, so its state
  # (and the Omarchy shell menu) stays in sync. Fall back to raw sysfs for
  # max-power / custom, which ppd does not expose.
  local from armed_here=0
  from=$(rd $PROFILE)
  if raises_power "$want"; then
    gate profile "platform profile|$from|$want|profile" || return 1
    armed_here=1
  fi
  local ppd; ppd=$(fw_to_ppd "$want")
  if have powerprofilesctl && powerprofilesctl list 2>/dev/null | grep -q "^ *\*\? *${ppd}:"; then
    # Prefer Omarchy's wrapper when present: it also records the choice per
    # AC/battery state, so it survives a reboot and an unplug.
    if have omarchy-powerprofiles-set; then
      omarchy-powerprofiles-set autodetect "$ppd" || {
        (( armed_here )) && budget_abandon profile
        log_event "$ACTOR" profile "$from" "$want" failed "omarchy-powerprofiles-set failed"
        die "omarchy-powerprofiles-set $ppd failed"; }
    else
      powerprofilesctl set "$ppd" || {
        (( armed_here )) && budget_abandon profile
        log_event "$ACTOR" profile "$from" "$want" failed "powerprofilesctl failed"
        die "powerprofilesctl set $ppd failed"; }
    fi
  else
    if ! wr $PROFILE "$want"; then
      (( armed_here )) && budget_abandon profile
      log_event "$ACTOR" profile "$from" "$want" failed
      if [[ $want == custom ]]; then
        echo "note: this firmware lists 'custom' in platform_profile_choices but rejects" >&2
        echo "      writes to it (EINVAL). Custom mode appears to be reachable only from" >&2
        echo "      the Fn+Q hardware key, not sysfs, so cpu-limit cannot be applied." >&2
      fi
      return 1
    fi
    echo "note: '$want' is not a power-profiles-daemon profile; ppd still reports its own" >&2
    echo "      last-set profile and may override this on the next AC/battery change." >&2
  fi
  # Setting max-power/custom writes sysfs behind ppd's back, so ppd's cached
  # state can already equal the profile we now want - making its set a no-op
  # that leaves the firmware where it was. Reconcile the two.
  if [[ $(rd $PROFILE) != "$want" ]]; then
    if ! wr $PROFILE "$want"; then
      (( armed_here )) && budget_abandon profile
      log_event "$ACTOR" profile "$from" "$want" failed
      return 1
    fi
  fi

  log_event "$ACTOR" profile "$from" "$want" applied
  echo "platform profile: $(rd $PROFILE)"
}

# ---------------------------------------------------------------- cpu

cmd_epp() {
  local want=${1:-}
  if [[ -z $want ]]; then rd $CPUDIR/cpu0/cpufreq/energy_performance_preference; return; fi
  local avail; avail=$(rd $CPUDIR/cpu0/cpufreq/energy_performance_available_preferences)
  [[ " $avail " == *" $want "* ]] || die "epp must be one of: $avail"
  local from; from=$(rd $CPUDIR/cpu0/cpufreq/energy_performance_preference)
  local n=0
  for f in $CPUDIR/cpu*/cpufreq/energy_performance_preference; do
    wr "$f" "$want" >/dev/null 2>&1 && ((n++))
  done
  if (( n == 0 )); then
    log_event "$ACTOR" epp "$from" "$want" failed
    die "could not set EPP (run: lenovo-power install-perms)"
  fi
  log_event "$ACTOR" epp "$from" "$want" applied
  echo "EPP set to $want on $n cpus"
}

cmd_turbo() {
  local want=${1:-}
  if [[ -z $want ]]; then turbo_state; return; fi
  # no_turbo is inverted
  local b; b=$(to_bool "$want")
  local from to
  from=$(turbo_state)
  to=$(onoff "$b")
  wr_logged turbo $PSTATE/no_turbo "$from" "$to" "$(( 1 - b ))" || return 1
  echo "turbo: $(turbo_state)"
}

cmd_cpu_limit() {
  local pl1=${1:-} pl2=${2:-}
  if [[ -z $pl1 ]]; then
    printf 'PL1 %s W / PL2 %s W\n' "$(rd $FWA/ppt_pl1_spl/current_value)" "$(rd $FWA/ppt_pl2_sppt/current_value)"
    return
  fi
  [[ $(rd $PROFILE) == custom ]] || {
    echo "note: CPU power limits are only honoured in the 'custom' platform profile." >&2
    echo "      run: lenovo-power profile custom" >&2
  }
  # Both limits are validated before either is offered, so the prompt never asks
  # about a value the firmware would go on to reject.
  local lo hi from1 from2 rows
  lo=$(rd $FWA/ppt_pl1_spl/min_value); hi=$(rd $FWA/ppt_pl1_spl/max_value)
  (( pl1 >= lo && pl1 <= hi )) || die "PL1 must be ${lo}-${hi} W"
  if [[ -n $pl2 ]]; then
    lo=$(rd $FWA/ppt_pl2_sppt/min_value); hi=$(rd $FWA/ppt_pl2_sppt/max_value)
    (( pl2 >= lo && pl2 <= hi )) || die "PL2 must be ${lo}-${hi} W"
  fi

  from1=$(rd $FWA/ppt_pl1_spl/current_value)
  from2=$(rd $FWA/ppt_pl2_sppt/current_value)
  rows=("PL1 sustained|${from1} W|${pl1} W|cpu_pl1")
  [[ -n $pl2 ]] && rows+=("PL2 burst|${from2} W|${pl2} W|cpu_pl2")
  gate cpu-limit "${rows[@]}" || return 1

  if ! wr_logged cpu-limit-pl1 $FWA/ppt_pl1_spl/current_value "$from1" "$pl1"; then
    budget_abandon cpu_pl1 cpu_pl2
    return 1
  fi
  if [[ -n $pl2 ]] && ! wr_logged cpu-limit-pl2 $FWA/ppt_pl2_sppt/current_value "$from2" "$pl2"; then
    # PL1 did land, so that half stays armed and the latch stays off.
    budget_abandon cpu_pl2
    return 1
  fi
  cmd_cpu_limit
}

# ---------------------------------------------------------------- gpu

cmd_gpu_limit() {
  have nvidia-smi || die "nvidia-smi not installed"
  local want=${1:-}
  if [[ -z $want ]]; then
    nvidia-smi --query-gpu=enforced.power.limit,power.min_limit,power.max_limit \
      --format=csv,noheader,nounits | awk -F', ' '{printf "%s W (range %s-%s)\n",$1,$2,$3}'
    return
  fi
  local from; from=$(gpu_power_limit)
  gate gpu-limit "dGPU power cap|${from} W|${want} W|gpu" || return 1
  if ! sudo nvidia-smi -pl "$want" >/dev/null; then
    budget_abandon gpu
    log_event "$ACTOR" gpu-limit "$from" "$want" failed
    die "failed to set GPU power limit"
  fi
  log_event "$ACTOR" gpu-limit "$from" "$want" applied
  cmd_gpu_limit
}

# ---------------------------------------------------------------- toggles

cmd_toggle() { # <setting> <label> <path> <arg>
  local setting=$1 label=$2 path=$3 arg=${4:-}
  if [[ -z $arg ]]; then onoff "$(rd "$path")"; return; fi
  local b; b=$(to_bool "$arg")
  wr_logged "$setting" "$path" "$(onoff "$(rd "$path")")" "$(onoff "$b")" "$b" || return 1
  printf '%s: %s\n' "$label" "$(onoff "$(rd "$path")")"
}

# ---------------------------------------------------------------- presets

cmd_preset() {
  local p=${1:-}
  # Everything a preset writes is attributed to the preset, so the log can tell
  # a one-word command apart from the same settings changed by hand.
  local from; from=$(rd $STATE_DIR/preset)
  ACTOR=preset
  case "$p" in
    quiet)   cmd_profile low-power;   cmd_epp power;                cmd_turbo off ;;
    travel)  cmd_profile low-power;   cmd_epp balance_power;        cmd_turbo on  ;;
    work)    cmd_profile balanced;    cmd_epp balance_performance;  cmd_turbo on  ;;
    game)    cmd_profile performance; cmd_epp performance;          cmd_turbo on  ;;
    max)
      # Asked once here rather than by the profile inside it, so a one-word
      # command cannot walk around the guardrail it would otherwise trip.
      GATE_NOTE="'preset max' includes 'profile max-power', which is why it asks."
      gate preset "platform profile|$(rd $PROFILE)|max-power" \
                  "EPP|$(rd $CPUDIR/cpu0/cpufreq/energy_performance_preference)|performance" \
                  "turbo|$(turbo_state)|on" || return 1
      cmd_profile max-power;   cmd_epp performance;          cmd_turbo on  ;;
    "")      [[ -r $STATE_DIR/preset ]] && cat "$STATE_DIR/preset" || echo "(none set)"; return ;;
    *) die "preset must be one of: quiet travel work game max" ;;
  esac
  mkdir -p "$STATE_DIR" && echo "$p" >"$STATE_DIR/preset"
  log_event "$ACTOR" preset "${from:--}" "$p" applied
}

# ---------------------------------------------------------------- monitor
#
# The guard is explicitly not damage protection. The firmware's thermal ladder
# is: it reacts in milliseconds, it cannot be switched off, and nothing here
# weakens it. This is a comfort and longevity policy - it keeps the machine out
# of the throttle zone, where it would otherwise sit hot and loud with the fans
# at maximum. The firmware cannot make that call, because the firmware does not
# know the user would rather have less performance.

epoch() { date +%s; }

notify() { # <urgency> <summary> <body>
  have notify-send || return 0
  notify-send -a lenovo-power -u "$1" "$2" "$3" 2>/dev/null || return 0
}

# The dGPU's remaining thermal margin in whole degrees, and only while the card
# is already awake: polling a runtime-suspended card resumes it and costs about
# 10 W, so monitoring must never be the thing that wakes it. Cards that do not
# report a margin say so, and get no alerting.
gpu_margin() {
  [[ $(gpu_runtime_status) == active ]] || return 0
  local m; m=$(nvidia-smi --query-gpu=temperature.gpu.tlimit --format=csv,noheader,nounits 2>/dev/null)
  [[ $m =~ ^[0-9]+$ ]] && printf '%s\n' "$m"
  return 0
}

# How long the reading has been continuously over its threshold, or empty when
# it is not over it. The start of the run lives in the state file, because the
# single poll and the loop share one another's history through it.
sustained_for() { # <key> <over?> <now>
  local key=$1 over=$2 now=$3 since
  if [[ $over != 1 ]]; then state_clear "$key"; return 0; fi
  since=$(state_get "$key")
  if [[ -z $since ]]; then since=$now; state_set "$key" "$now"; fi
  printf '%s\n' "$(( now - since ))"
}

# Give back whatever was raised - specifically that, since dropping the profile
# alone would leave a raised GPU cap in place, and the cap lives outside the
# platform profile entirely.
guard_act() { # <temp> <held-for>
  local temp=$1 held=$2 gave
  ACTOR=guard
  LOG_DETAIL="CPU ${temp} C sustained ${held}s"

  # Latching rather than restoring on the way down: restoring automatically
  # guarantees oscillation - drop, cool, restore, heat, drop - which would flap
  # the profile and fill the log. The user re-enables deliberately, and the
  # gate's hot refusal stops an immediate re-entry.
  gave=$(budget_give_back) || { LOG_DETAIL=; return 0; }

  # The machine is by definition over the alert threshold too, and the guard's
  # notification is the one that explains what just happened. Count this as the
  # alert so the two do not arrive together.
  state_set alert_last "$(epoch)"

  local body="${LOG_DETAIL}. Gave back: ${gave}."
  body+=" It stays here until you raise it again."
  notify critical "Power budget given back" "$body"
  echo "guard: $body"
  LOG_DETAIL=
}

# One poll. The loop is a thin wrapper over exactly this, so what the loop does
# every interval is what a single poll reports right now.
monitor_poll() {
  local verbose=${1:-0} temp margin held now
  now=$(epoch)
  temp=$(cpu_temp)

  if [[ -z $temp ]]; then
    (( verbose )) && echo "monitor: no CPU temperature sensor on this machine"
    return 0
  fi

  # Guard first: at that temperature the alert has already had its say.
  held=$(sustained_for hot_since "$([[ $temp -ge $GUARD_TEMP ]] && echo 1 || echo 0)" "$now")
  if [[ -n $held ]] && (( held >= GUARD_SUSTAIN )); then
    state_clear hot_since
    guard_act "$temp" "$held"
  fi

  # Awareness while the machine is still coping, rate limited so a long hot
  # session does not bury the notifications it sends.
  held=$(sustained_for alert_since "$([[ $temp -ge $ALERT_TEMP ]] && echo 1 || echo 0)" "$now")
  if [[ -n $held ]] && (( held >= ALERT_SUSTAIN )); then
    local last; last=$(state_get alert_last)
    if [[ -z $last ]] || (( now - last >= ALERT_REPEAT )); then
      state_set alert_last "$now"
      notify normal "CPU running hot" \
        "${temp} °C, held for ${held}s. The firmware's fans stage in at 103 °C."
      echo "alert: CPU ${temp} °C held for ${held}s"
    fi
  fi

  margin=$(gpu_margin)
  if [[ -n $margin ]] && (( margin <= GPU_MARGIN )); then
    local last; last=$(state_get gpu_alert_last)
    if [[ -z $last ]] || (( now - last >= ALERT_REPEAT )); then
      state_set gpu_alert_last "$now"
      notify normal "dGPU close to its thermal limit" \
        "${margin} °C of thermal margin left."
      echo "alert: dGPU has ${margin} °C of margin left"
    fi
  fi

  if (( verbose )); then
    printf 'CPU %s °C  (alert %s °C, guard %s °C)\n' "$temp" "$ALERT_TEMP" "$GUARD_TEMP"
    [[ -n $margin ]] && printf 'dGPU %s °C of thermal margin  (alert at %s °C)\n' "$margin" "$GPU_MARGIN"
    printf 'the guard would: %s\n' "$(budget_plan)"
    budget_latched && printf 'guard: latched %s\n' "$(budget_latch_at)"
  fi
  return 0
}

cmd_monitor() {
  case "${1:-}" in
    once) monitor_poll 1 ;;
    run)
      # Deliberately not a systemd timer: the sustained-temperature windows are
      # shorter than a timer's useful resolution, and the state file already
      # carries the run across polls.
      echo "lenovo-power monitor: polling every ${POLL_INTERVAL}s" \
           "(alert ${ALERT_TEMP} °C/${ALERT_SUSTAIN}s, guard ${GUARD_TEMP} °C/${GUARD_SUSTAIN}s)"
      while :; do
        monitor_poll 0
        sleep "$POLL_INTERVAL"
      done ;;
    *) die "monitor takes 'once' or 'run'" ;;
  esac
}

# ---------------------------------------------------------------- history

cmd_history() {
  # Dispatch passes an empty string when the argument is absent, so the default
  # has to survive that as well as an unset parameter.
  local n=${1:-}; n=${n:-20}
  case "$n" in
    all)     n=0 ;;
    *[!0-9]*) die "history takes a number of entries, or 'all'" ;;
  esac
  [[ -s $LOG_FILE ]] || { echo "(no history yet)"; return 0; }

  # Widths come from the rows actually being shown, so the columns are as narrow
  # as the data allows rather than padded to some guessed maximum.
  { if (( n > 0 )); then tail -n "$n" "$LOG_FILE"; else cat "$LOG_FILE"; fi; } | awk '
    function jget(field,   v) {
      if (!match($0, "\"" field "\":\"")) return "-"
      v = substr($0, RSTART + RLENGTH)
      v = substr(v, 1, index(v, "\"") - 1)
      return v == "" ? "-" : v
    }
    function wider(col, v) { if (length(v) > w[col]) w[col] = length(v) }
    BEGIN {
      split("TIME ACTOR SETTING FROM TO OUTCOME DETAIL", head, " ")
      for (c = 1; c <= 7; c++) w[c] = length(head[c])
    }
    {
      n++
      # "2026-09-01T14:30:00-04:00" reads better as a date and a wall clock.
      ts = jget("ts"); sub("T", " ", ts); ts = substr(ts, 1, 16)
      row[n, 1] = ts
      row[n, 2] = jget("actor");   row[n, 3] = jget("setting")
      row[n, 4] = jget("from");    row[n, 5] = jget("to")
      row[n, 6] = jget("outcome"); row[n, 7] = jget("detail")
      for (c = 1; c <= 7; c++) wider(c, row[n, c])
    }
    END {
      # The detail column is last and ragged, so it is never padded.
      for (c = 1; c <= 6; c++) printf "%-*s  ", w[c], head[c]
      printf "%s\n", head[7]
      for (r = 1; r <= n; r++) {
        for (c = 1; c <= 6; c++) printf "%-*s  ", w[c], row[r, c]
        printf "%s\n", row[r, 7]
      }
    }'
}

# ---------------------------------------------------------------- perms

cmd_install_perms() {
  # Resolve through the symlink in ~/.local/bin back to the repo checkout, so
  # the installer that ships alongside this script is the one that runs.
  local self here installer
  self=$(readlink -f "${BASH_SOURCE[0]}")
  here=$(dirname "$self")
  for installer in "$here/../scripts/install-perms.sh" \
                   "$HOME/.local/share/lenovo-power/install-perms.sh"; do
    [[ -x $installer ]] && break
  done
  [[ -x $installer ]] || die "installer not found next to $self"
  echo "This grants group 'wheel' write access to the Lenovo power sysfs knobs,"
  echo "so lenovo-power no longer needs sudo. Requires your password."
  echo

  if [[ -t 0 || -t 1 || -t 2 ]]; then
    sudo "$installer"
    return
  fi

  # No controlling terminal (launched from a keybind, an agent, or a shell
  # wrapper), so sudo has nowhere to prompt. Fall back to a graphical askpass
  # dialog if a usable one is installed.
  #
  # Deliberately excludes gcr's helpers (/usr/lib/gcr*-ssh-askpass): they abort
  # with "this program is not meant to be run directly" unless invoked by gcr's
  # own ssh-agent, so they are useless as a generic SUDO_ASKPASS.
  local askpass
  for askpass in "${SUDO_ASKPASS:-}" /usr/lib/ssh/ssh-askpass \
                 /usr/libexec/openssh/gnome-ssh-askpass \
                 /usr/bin/lxqt-openssh-askpass /usr/bin/ksshaskpass; do
    [[ -n $askpass && -x $askpass ]] || continue
    SUDO_ASKPASS="$askpass" sudo -A "$installer"
    return
  done

  echo "No terminal to prompt on, and no usable askpass helper is installed." >&2
  echo "Open a terminal window and run:  lenovo-power install-perms" >&2
  exit 1
}

cmd_install_monitor() {
  local self unit_dir unit
  self=$(readlink -f "${BASH_SOURCE[0]}")
  unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
  unit="$unit_dir/lenovo-power-monitor.service"
  mkdir -p "$unit_dir" || die "cannot create $unit_dir"

  # A user service, not a system one. The monitor only writes platform_profile
  # and the firmware-attribute power limits, which install-perms already hands
  # to the wheel group, so it can de-escalate with no privilege escalation and
  # no password prompt from a background process.
  cat >"$unit" <<UNITEOF
[Unit]
Description=Lenovo power thermal monitor
Documentation=https://github.com/rwildcard/lenovo-power

[Service]
Type=simple
ExecStart=$self monitor run
Restart=on-failure
RestartSec=30

# Thresholds. Edit them here, then:
#   systemctl --user daemon-reload && systemctl --user restart lenovo-power-monitor
Environment=LENOVO_POWER_ALERT_TEMP=$ALERT_TEMP
Environment=LENOVO_POWER_ALERT_SUSTAIN=$ALERT_SUSTAIN
Environment=LENOVO_POWER_ALERT_REPEAT=$ALERT_REPEAT
Environment=LENOVO_POWER_GUARD_TEMP=$GUARD_TEMP
Environment=LENOVO_POWER_GUARD_SUSTAIN=$GUARD_SUSTAIN
Environment=LENOVO_POWER_GPU_MARGIN=$GPU_MARGIN
Environment=LENOVO_POWER_POLL_INTERVAL=$POLL_INTERVAL

[Install]
WantedBy=default.target
UNITEOF

  systemctl --user daemon-reload || die "systemctl --user daemon-reload failed"
  systemctl --user enable --now lenovo-power-monitor.service ||
    die "could not enable lenovo-power-monitor.service"

  echo "Installed and started:"
  echo "  $unit"
  echo
  echo "It warns at ${ALERT_TEMP} °C held for ${ALERT_SUSTAIN}s, and gives back a raised power"
  echo "budget at ${GUARD_TEMP} °C held for ${GUARD_SUSTAIN}s. Check it now without waiting:"
  echo "  lenovo-power monitor once"
  echo
  echo "Stop it again with:  systemctl --user disable --now lenovo-power-monitor"
}

usage() {
  cat <<'USAGE'
lenovo-power - control Lenovo Legion power settings

  status                        show everything (default)
  profile [NAME]                low-power | balanced | performance | max-power | custom
  preset [NAME]                 quiet | travel | work | game | max
  epp [PREF]                    power | balance_power | balance_performance | performance | default
  turbo [on|off]                intel_pstate turbo boost
  cpu-limit [PL1 [PL2]]         CPU sustained / burst watts (needs 'custom' profile)
  gpu-limit [WATTS]             NVIDIA dGPU power cap (needs sudo)
  battery-cap [on|off]          conservation mode - hold charge at ~60%
  usb-charging [on|off]         charge USB devices while the lid is shut
  fn-lock [on|off]              Fn key lock
  history [N|all]               the last N power changes (default 20)
  monitor once|run              one temperature poll, or keep polling
  install-perms                 allow the wheel group to write these knobs (no more sudo)
  install-monitor               start watching the temperature (a user service)

Reading a setting: omit the argument.

Raising a power budget - max-power, custom, cpu-limit, gpu-limit - asks first.
Pass --yes to skip the prompt from a script or a keybinding; it does not
override the refusal to raise while the CPU is already hot.
USAGE
}

# --yes may appear anywhere, so a keybinding or a script can append it without
# having to care where the command's own arguments end.
args=()
for arg in "$@"; do
  case "$arg" in
    --yes|-y) ASSUME_YES=1 ;;
    *)        args+=("$arg") ;;
  esac
done
set -- ${args[@]+"${args[@]}"}

case "${1:-status}" in
  status|"")      cmd_status ;;
  profile)        cmd_profile "${2:-}" ;;
  preset)         cmd_preset "${2:-}" ;;
  epp)            cmd_epp "${2:-}" ;;
  turbo)          cmd_turbo "${2:-}" ;;
  cpu-limit)      cmd_cpu_limit "${2:-}" "${3:-}" ;;
  gpu-limit)      cmd_gpu_limit "${2:-}" ;;
  battery-cap)    cmd_toggle battery-cap "conservation mode" $VPC/conservation_mode "${2:-}" ;;
  usb-charging)   cmd_toggle usb-charging "USB always-on" $VPC/usb_charging "${2:-}" ;;
  fn-lock)        cmd_toggle fn-lock "Fn lock" $VPC/fn_lock "${2:-}" ;;
  history)        cmd_history "${2:-}" ;;
  monitor)        cmd_monitor "${2:-}" ;;
  install-perms)  cmd_install_perms ;;
  install-monitor) cmd_install_monitor ;;
  -h|--help|help) usage ;;
  *)              usage; exit 1 ;;
esac
